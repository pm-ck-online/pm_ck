# .streamlit/secrets.toml.example
# =================================
# ĐÂY LÀ FILE MẪU — không chứa mật khẩu thật, AN TOÀN để đưa lên GitHub.
#
# Cách dùng:
#   1. KHÔNG cần tạo file secrets.toml thật trên máy cục bộ (chỉ cần khi
#      deploy lên Streamlit Community Cloud).
#   2. Khi deploy lên Streamlit Cloud, vào App Settings -> Secrets, dán
#      đúng nội dung dưới đây (bỏ dấu # ở đầu dòng), thay giá trị thật vào.
#
# connection string lấy từ: Supabase Dashboard -> nút "Connect" ở đầu
# trang -> chọn "Session pooler".

# SUPABASE_CONNECTION_STRING = "postgresql://postgres.xxxxx:MatKhauThat@aws-x-xx-xxxx-x.pooler.supabase.com:5432/postgres"
